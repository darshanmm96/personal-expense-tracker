# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
# Local example: mongodb://127.0.0.1:27017/personal_expense_tracker
# Atlas example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/personal_expense_tracker
MONGO_URI=mongodb://127.0.0.1:27017/personal_expense_tracker

# Authentication - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d

# Frontend origin(s), comma separated if more than one
CLIENT_URL=http://localhost:5173
